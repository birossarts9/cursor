/** 본문 **/
.asil_title {position:relative; height:45px; background:url(../images/contents/bg_asil_title.png) no-repeat 0 center;}
.asil_title > p {height:45px; line-height:45px; font-weight:bold; font-size:17px; color:#fff; letter-spacing:0; text-align:center;}
.asil_title > a {position:absolute; top:0; width:40px; height:45px; text-indent:-9999px;}
.asil_title > a.addFav {right:5px; background:url(../images/contents/bg_interest.png) no-repeat 0 center;}
.asil_title > a.addFav.on {background-position:-40px center;}
.asil_title > a.thisClose {left:5px; background:url(../images/contents/bg_this_close.png) no-repeat 0 center;}

.tab_menu {height:50px; padding:10px 12px; border-bottom:1px solid #ddd;}
.tab_menu ul {overflow:hidden;}
.tab_menu ul li {float:left; width:32%; margin-left:2%;}
.tab_menu ul li:first-child {margin-left:0;}
.tab_menu ul li a {display:block; height:30px; line-height:30px; border-radius:5px; background:#eee; text-align:center;}
.tab_menu ul li a.on {font-weight:bold; color:#fff; background:#ffa300;}

.sale_list {height:calc(100% - 60px); overflow-y:auto;}

.btn_detail_close {position:absolute; top:20px; right:12px; display:block; width:18px; height:17px; background:url(../images/contents/detail_wrap_close.png) no-repeat 0 0;}



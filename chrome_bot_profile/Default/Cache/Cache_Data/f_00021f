.big_image {display:none; position:absolute; width:100%; top:0; right:0; bottom:0; left:0; z-index:5000; background:rgba(0,0,0,0.65); overflow:auto;}
.big_image > .inr {width:100%; height:100%;}
.big_image > .inr > p {}
.big_image > .inr > p img {margin:0 auto;}
.big_image > .inr > .close {position:fixed; top:15px; left:50%; display:block; width:50px; height:50px; margin-left:-25px; background:url(../images/contents/btn_big_image_close.png) no-repeat 0 0; text-indent:-9999px;}

/* 그래프 크게보기 */
.big_graph {display:none; position:absolute; width:800px; top:140px; left:390px; z-index:5000; background:#eee;}
.big_graph > .tit {height:45px; line-height:45px; font-weight:bold; font-size:17px; color:#fff; background:url(../images/contents/bg_big_graph_tit.png) no-repeat center center; text-align:center;}
.big_graph > .close {position:absolute; top:0; right:0; width:45px; height:45px; background:url(../images/contents/btn_big_graph_close.png) no-repeat center center;}
.big_graph > .cont {padding:15px;}
.big_graph > .cont > div {height:370px; padding:20px; border-radius:8px; background:#fff;}


/* 유틸내용 */
.util_cont {display:none; position:absolute; width:100%; top:0; right:0; bottom:0; left:0; z-index:5000; background:rgba(0,0,0,0.65);}
.util_cont > .inr {position:absolute; width:800px; height:780px; top:80px; left:50%; z-index:5000; margin-left:-400px; border-radius:10px; background:#fff; overflow:hidden;}
.util_cont > .inr > .tit {height:45px; line-height:45px; font-weight:bold; font-size:17px; color:#fff; background:#1c32f7; text-align:center;}
.util_cont > .inr > .close {position:absolute; top:5px; right:10px; display:block; width:45px; height:45px; background:url(/asil/images/contents/btn_big_graph_close.png) no-repeat center center; text-indent:-9999px;}
.util_cont > .inr > .close.black {background-image:url(/asil/images/contents/btn_big_graph_close_black.png);}
.util_cont > .inr > .cont {width:100%; height:100%; overflow:hidden;}
.util_cont > .inr > .cont > div {display:none; width:100%; height:100%;}
.util_cont > .inr > .cont iframe {width:100%; height:100%;}


/** 매매 **/
.mn_deal {position:relative; height:45px;}
.mn_deal:after {content:''; position:absolute; bottom:0; z-index:-1; display:block; width:100%; height:2px; background:#ccc;}
.mn_deal > ul {padding-left:9px; overflow:hidden;}
.mn_deal > ul > li {float:left; position:relative;}
.mn_deal > ul > li > a {display:block; height:45px; line-height:45px; padding:0 9px; font-weight:bold; color:#888;}
.mn_deal > ul > li > a.on {color:#333; border-bottom:3px solid #333;}
.mn_deal > ul > li > span {display:block; position:absolute; top:5px; right:-2px; min-width:16px; height:16px; line-height:16px; font-size:11px; color:#fff; border-radius:8px; background:#ff0000; text-align:center;}


.mn_view {overflow:hidden;}
.mn_view > a {display:block; float:left; width:50%; height:40px; font-size:13px; background:#eee; text-align:center;}
.mn_view > a.on {color:#fff; background:#4fa5ee;}
.mn_view > a > span {display:inline-block; position:relative; line-height:40px; padding-left:25px;}
.mn_view > a > span:before {content:''; position:absolute; top:12px; left:0; display:block; width:19px; height:17px; background:url(../images/contents/ico_view.png) no-repeat 0 0;}
.mn_view > a > span.tbl:before {background-position:0 0;}
.mn_view > a.on > span.tbl:before  {background-position:0 -20px;}
.mn_view > a > span.graph:before {background-position:-20px 0;}
.mn_view > a.on > span.graph:before {background-position:-20px -20px;}


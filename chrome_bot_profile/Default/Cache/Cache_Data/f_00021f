.mn_trade {position:relative; height:40px; padding:0 18px 0 13px; border-bottom:1px solid #ccc;}
.mn_trade:after {content:''; display:block; clear:both;}
.mn_trade > ul {float:left; overflow:hidden;}
.mn_trade > ul > li {float:left; margin-right:10px;}
.mn_trade > ul > li > a {position:relative; display:block; height:39px; line-height:39px; font-weight:bold; color:#888;}
.mn_trade > ul > li > a.on {color:#333;}
.mn_trade > ul > li > a#deal1.on {color:#1c32f7;}
.mn_trade > ul > li > a#deal2.on {color:#ff6445;}
.mn_trade > ul > li > a#deal3.on {color:#1bb70e;}

.mn_trade .trade_date {float:right; position:relative;}
.mn_trade .trade_date > a {display:block; height:39px;}
.mn_trade .trade_date > a > span {position:relative; display:inline-block; padding-right:16px; line-height:39px; font-weight:bold;}
.mn_trade .trade_date > a > span:after {content:''; position:absolute; top:50%; right:0; width:10px; height:6px; margin-top:-3px; background:url(../images/contents/bg_mn_area_arr.png) no-repeat 0 0;}
.mn_trade .trade_date > a.on > span:after {background-position:0 -6px;}
.mn_trade .trade_date > div {display:none; position:absolute; top:39px; right:-18px; z-index:2010; min-width:100px; min-height:128px; border:1px solid #ccc; border-right:0; background:#fff; overflow-y:auto;}
.mn_trade .trade_date > div > ul {padding:3px 0;}
.mn_trade .trade_date > div > ul > li {}
.mn_trade .trade_date > div > ul > li > a {display:block; height:24px; line-height:24px; padding:0 0 0 6px; font-size:13px; white-space:nowrap; }
.mn_trade .trade_date > div > ul > li > a.on {font-weight:bold;}
.mn_trade .trade_date > div > ul > li > a:hover {background:#eee;}
.mn_trade .trade_date > a.on ~ div {display:block;}


.mn_area {position:relative; z-index:2001; width:100%; height:40px; padding:0 82px 0 10px; border-bottom:1px solid #e4e4e4; background:#f8f9fb; overflow:hidden;}
.mn_area .scroll {position:relative; width:100%; height:39px; overflow:hidden;}
.mn_area .scroll .mCSB_container_wrapper {height:39px; margin-right:0; margin-bottom:0;}
.mn_area .scroll .mCSB_container_wrapper > .mCSB_container {padding-right:0; padding-bottom:0;}
.mn_area .scroll .mCSB_scrollTools .mCSB_draggerContainer {}
.mn_area .scroll .mCSB_scrollTools.mCSB_scrollTools_horizontal .mCSB_draggerRail {height:4px; margin-top:11px;}
.mn_area .scroll .mCSB_scrollTools.mCSB_scrollTools_horizontal .mCSB_dragger .mCSB_dragger_bar {margin-top:11px;}
.mn_area .scroll.scroll2 {overflow-y:hidden !important;}
.mn_area .scroll.scroll2::-webkit-scrollbar {height:4px !important;} 

.mn_area > div ul {display:inline; /*width:350px;*/ height:39px; white-space:nowrap; text-overflow:ellipsis; overflow:inherit;}
.mn_area > div ul > li {display:inline;}
.mn_area > div ul > li > a {display:inline-block; /*width:50px;*/ height:38px; padding:3px 7px 0; line-height:16px; font-size:13px; color:#777; text-align:center; vertical-align:middle;}
.mn_area > div ul > li > a > span {font-weight:normal; font-size:12px; color:#888; letter-spacing:-0.02em;}
.mn_area > div ul > li > a.on,
.mn_area > div ul > li > a.on > span {font-weight:bold; color:#1c32f7;}
.mn_trade ~ .mn_area  ul > li > a {padding-top:4px;}
.mn_area ~ .mn_area  ul > li > a {padding-top:4px;}
.mn_area > div #mCSB_2  ul > li > a {}
.mn_area .btn_bind {position:absolute; top:7px; right:16px; display:block; width:54px; height:26px; line-height:24px; font-weight:bold; font-size:13px; color:#777; background:#ddd; text-align:center;}
.mn_area .btn_bind.on {color:#fff; background:#1c32f7;}

#userDiv.mn_area {padding-right:10px; overflow:inherit;}
#userDiv.mn_area > div {position:absolute; left:0; right:0; overflow-y:auto;}
#userDiv.mn_area > div > ul {display:inline; white-space:nowrap; text-overflow:ellipsis; overflow:inherit;}
#userDiv.mn_area > div > ul > li {float:none; display:inline; } 
#userDiv.mn_area > div > ul > li > a {display:inline-block; width:80px; padding:4px 2px 0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
#userDiv.mn_area ~ .sale_list_body {padding-top:16px;}

.mn_sale {height:40px; padding-left:18px; border-bottom:1px solid #ccc; overflow:hidden;}
.mn_sale a {display:inline-block; height:24px; margin:8px 3px 0 0; padding:0 10px; line-height:22px; border:1px solid #888; border-radius:12px;}
.mn_sale a.on {color:#fff; background:#888;}


.mn_align {height:40px; padding-left:18px; border-bottom:1px solid #ccc; overflow:hidden;}
.mn_align a {display:block; float:left; position:relative; line-height:39px; padding:0 10px;}
.mn_align a:before {content:''; position:absolute; top:50%; left:0; display:block; width:1px; height:12px; margin-top:-6px; background:#ccc;}
.mn_align a:first-child {padding-left:0;}
.mn_align a:first-child:before {display:none;}


.crc {display:inline-block; position:relative; min-width:15px; min-height:15px; padding-left:15px; line-height:1; font-size:14px; vertical-align:middle;}
.crc.trd1,
.crc.trd2,
.crc.trd3 {padding-left:18px;}
.crc.trd1 {color:#2699fb;}
.crc.trd2 {color:#f75b59;}
.crc.trd3 {color:#00ad18;}
.crc:before {content:''; position:absolute; top:0; left:0; width:15px; height:15px; background:url(../images/contents/ico_crc.png) no-repeat 0 center;}
.crc.excl:before {background-position:0 center;}
.crc.no1:before {background-position:-20px center;}
.crc.no3:before {background-position:-40px center;}
.crc.no7:before {background-position:-60px center;}
.crc.no15:before {background-position:-80px center;}
.crc.trd1:before {background-position:-100px center;}
.crc.trd2:before {background-position:-120px center;}
.crc.trd3:before {background-position:-140px center;}


.real_deal_head {height:40px; padding:11px 18px 0; overflow:hidden;}
.real_deal_head > .guide_btn {float:left; display:block; font-weight:bold;}
.real_deal_head > .guide_btn span {margin-left:3px;}
.real_deal_head > .guide_txt {float:right; text-align:right;}
.real_deal_head > .guide_txt > div {display:inline-block; padding-right:2px; vertical-align:top;}


.real_deal_body {height:calc(100% - 80px) !important; overflow-y:hidden;}
.sale_list_body {height:calc(100% - 170px); /*overflow-y:auto;*/}


.estate_agent_recom {border-bottom:1px solid #d9d9d9; background:#f8f8f8; overflow:hidden;}
.estate_agent_recom li {float:left; width:50%; height:42px; line-height:42px; padding-left:10px; overflow:hidden;}
.estate_agent_recom li p {float:left; width:29px; height:29px; margin:6px 7px 0 0; border-radius:50%;  background:#eee url(../images/contents/ico_estate_agent_s.png) no-repeat center center; overflow:hidden;}
.estate_agent_recom li p img {width:29px; height:29px;}


.real_deal_tbl {width:100%; word-break:break-all; word-wrap:break-word;}
.real_deal_tbl tr {border-bottom:1px solid #ccc;}
.real_deal_tbl td {padding:5px 6px; font-size:13px; border-right:1px solid #ccc; vertical-align:top;}
.real_deal_tbl tr td:last-of-type {border-right:0;}
.real_deal_tbl .date1 {font-weight:bold; text-align:center;}
.real_deal_tbl .date2 {text-align:center;}
.real_deal_tbl .days {text-align:center;}
.real_deal_tbl .price {font-weight:bold;}
.real_deal_tbl .aptNum {}
.real_deal_tbl .aptNum span {display:block;}
.real_deal_tbl .aptNum span.dong {float:left;}
.real_deal_tbl .aptNum span.floor {float:right; text-align:right;}


.real_estate_agent {padding:18px;}
.real_estate_agent .item {position:relative; margin-top:18px; padding:10px 12px 12px 100px; border:1px solid #bbb; border-radius:5px; overflow:hidden;}
.real_estate_agent .item:first-child {margin-top:0;}
.real_estate_agent .item > .img {position:absolute; top:12px; left:12px; width:74px; height:74px; border:1px solid #8c8c8c; background:#f5f5f5 url(../images/contents/ico_estate_agent.png) no-repeat center center;}
.real_estate_agent .item > div {}
.real_estate_agent .item > div .tit {font-weight:bold; font-size:16px;}
.real_estate_agent .item > div .ctn {padding-top:5px; font-size:13px;}
.real_estate_agent .item > div .btn {padding-top:8px; }


.differ {display:inline-block; position:relative; min-height:12px; padding-left:12px; font-size:12px; line-height:1;}
.differ:before {content:''; position:absolute; top:50%; left:0; display:block; width:10px; height:10px; margin-top:-5px; background:url(../images/contents/arr_up_down.png) no-repeat 0 center;}
.differ.up:before {background-position:0 center;}
.differ.dn:before {background-position:-10px center;}


.apt_price_chart {display:none; position:fixed; top:40px; width:100%; height:100%; z-index:2010; background:#fff;}
.apt_sise_chart {display:none; position:fixed; top:120px; width:100%; height:100%; z-index:2010; background:#fff;}


/* 순위분석 */
.rankingList {padding:15px 16px;}
.rankingList .ttl {font-family:'Nanum Gothic'; font-weight:600; font-size:17px;}
.rankingList .sbttl {padding-top:8px; font-family:'Nanum Gothic'; font-size:13px; color:#8e8e8e;}
.rankingList > ul {padding-top:3px;}
.rankingList > ul > li {margin-top:8px; }
.rankingList > ul > li:first-child {margin-top:0;}
.rankingList > ul > li > a {display:block; padding:12px 16px; letter-spacing:-0.03em; border:2px solid #bbb; border-radius:3px;}
.rankingList > ul > li > a:hover,
.rankingList > ul > li > a.on {border-color:#4481ff;}
.rankingList > ul > li > a > strong {display:block; font-family:"NSR"; font-weight:700; font-size:15px; color:#080808;}
.rankingList > ul > li > a > span {display:block; padding-top:3px; font-size:13px; color:#080808;}

.gotoTop {display:none; position:fixed; right:20px; bottom:20px; z-index:10; width:40px; height:40px; border-radius:50%; background:rgba(28,50,247,0.8);}
.gotoTop > a {display:block; width:40px; height:40px; background:url(/app/images/arr2_up.png) no-repeat center center; background-size:12px 8px; text-indent:-9999em;}

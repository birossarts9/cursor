.btn_st1.rd {border-radius:3px;}
.btn_st1.c0 {background:#fff; color:#666;}
.btn_st1.c1 {background:#2699fb;}
.btn_st1.c2 {background:#f36a68;}
.btn_st1.c3 {background:#32c04e;}
.btn_st1.c4 {background:#606bec;}

.btn_st2 {display:inline-block; height:26px; padding:0 8px; line-height:24px; font-size:13px; color:#666; border:1px solid #7c7c7c; background:#fff; text-align:center; box-sizing:border-box;}
.btn_st2.rd {border-radius:3px;}
.btn_st2.c1 {color:#2699fb; border-color:#2699fb;}

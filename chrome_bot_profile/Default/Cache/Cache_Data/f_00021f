.btn_st21 {display:inline-block; height:26px; padding:0 8px; font-size:13px; color:#666; border:1px solid #7c7c7c; border-radius:12px; background:#fff; text-align:center; box-sizing:border-box;}
.btn_st21.c1 {color:#2699fb; border-color:#2699fb;}
.btn_st21.c2 {color:#f36a68; border-color:#f36a68;}
.btn_st21.c3 {color:#32c04e; border-color:#32c04e;}

.tbl_st1 {width:100%; border-top:1px solid #4a4a4a;}
.tbl_st1.bt0 {border-top:0;}
.tbl_st1 thead th,
.tbl_st1 tbody td {padding:5px 6px; font-size:13px; letter-spacing:-0.02em; border-left:1px solid #ccc; border-bottom:1px solid #ccc; text-align:center;}

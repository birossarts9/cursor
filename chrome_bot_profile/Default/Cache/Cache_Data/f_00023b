.sale_list_ver2 > .item.recom:after {content:""; display:block; width:30px; height:35px; position:absolute; top:0; right:10px; background:url(/rts_m/img/img_bookmark.png) no-repeat 0 0; background-size:30px 35px;}
.sale_list_ver2 > .item.focus:after {content:""; display:block; width:40px; height:40px; position:absolute; top:0; right:0; background:url(/rts_m/img/img_focus.png) no-repeat 0 0; background-size:40px 40px;}


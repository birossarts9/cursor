/* common */
.group		{width:100%; padding:16px; background:#fff;}
.article		{position:relative; margin-top:10px; margin-bottom:10px; padding:16px; box-shadow:0 0 10px rgba(0,0,0,0.08); background:#fff;}
.explain		{font-size:12px; color:#8e8e8e; letter-spacing:0.02em;}
h2.h2		{font-family:"NSR"; font-weight:800; font-size:16px; color:#000; letter-spacing:-0.02em;}
h3.h3		{margin-top:10px; font-weight:700; font-size:13px; color:#000; letter-spacing:0.02em;}
h2.tt2 {font-weight:700; font-size:16px; color:#000; letter-spacing:0.02em;} 

.head_wrap {position:relative; overflow:hidden;}
.head_wrap .back {display:block; float:left; width:30px; height:19px; margin-left:-2px; background:url(/app/images/arr_back.png) no-repeat 0 center; background-size:24px 24px;} 
.head_wrap .detail {position:absolute; display:block; top:0; right:0; font:normal 700 13px "NSR"; color:#1c32f7; line-height:19px;}

/* area_list */
.area_select {position:relative; height:51px; line-height:51px; background:#f0f1ff; overflow:hidden;}
.area_select > a {display:block; float:left; width:33.333%; font-size:16px; color:#171717; text-align:center;}
.area_select > a.on {color:#1c32f7;}
.area_select > span {position:absolute; display:block; float:left; width:20px; margin-left:-10px; color:#141414; text-align:center;}
.area_select > span.on {color:#1c32f7;}
.area_select > span.arr1 {left:33.333%;}
.area_select > span.arr2 {left:66.666%}

.area_list {margin-top:16px; border-top:1px solid #eee; border-left:1px solid #eee; overflow:hidden;}
.area_list span {display:block; float:left; width:33.333%; height:56px; font-size:15px; color:#000; line-height:56px; border-right:1px solid #eee; border-bottom:1px solid #eee; text-align:center;}
.area_list span:hover {color:#fff; background:#1c32f7;}

.area_list_wrap {position:relative; z-index:101;padding-bottom:88px;}
.area_list_wrap .btn_wrap {position:fixed; right:16px; bottom:16px; left:16px;}

.area_list2_wrap {position:relative; z-index:101; height:calc(100% - 67px); padding:0 16px 16px; overflow-y:auto;}		
.area_list2 {margin-top:16px; border-top:1px solid #eee; border-left:1px solid #eee; overflow:hidden;}
.area_list2 li {display:block; float:left; width:33.333%; height:56px; font-size:15px; color:#000; border-right:1px solid #eee; border-bottom:1px solid #eee; text-align:center;}
.area_list2 li:hover {color:#fff; background:#1c32f7;}
.area_list2 li > p {display:table; width:100%; height:55px;}
.area_list2 li > p > span {display:table-cell; width:100%; height:55px; padding:2px 8px 0; line-height:21px; vertical-align:middle;}

.apt_search_wrap {padding-top:60px; margin-bottom:-4px;}
.apt_search {position:fixed; top:0; z-index:103; width:100%; height:60px; padding:16px 16px 0; background:#fff;}
.apt_search > .keywords {height:44px; padding-left:44px; border-radius:1px; border:1px solid #bfc4ce; background:#fff url(/app/images/ico_search.png) no-repeat 12px center; background-size:24px 24px;}
.apt_search > .keywords.on {border-color:#1c32f7; background:url(/app/images/ico_search_on.png) no-repeat 12px center; background-size:24px 24px;}
.apt_search > .keywords input {width:100%; height:42px; border:0; line-height:42px; color:#050505;}
.apt_search > .keywords.on input {color:#1c32f7;}

.my_words {display:none; position:relative; width:100%; height:calc(100% - 60px); padding:88px 16px 9px;}
.my_words > .recent {position:relative;}
.my_words > .recent > h2 {font-weight:700; font-size:16px; color:#000;}
.my_words > .recent > .delete {position:absolute; top:5px; right:0; font-size:11px; color:#ff6544; letter-spacing:0.02em;}
.my_words > .recent > ul {padding-top:8px;}
.my_words > .recent > ul > li {position:relative;}
.my_words > .recent > ul > li.del {padding-right:22px;}
.my_words > .recent > ul > li > a {position:relative; display:block; padding:8px 0;}
.my_words > .recent > ul > li > a > span {display:block; letter-spacing:0.02em;}
.my_words > .recent > ul > li > a > .name {font-weight:700; color:#282828;}
.my_words > .recent > ul > li > a > .addr {padding-top:2px; font-size:12px; color:#282828;}
.my_words > .recent > ul > li > a > .date {position:absolute; top:11px; right:0; font-size:11px; color:#a3a5a9;}
.my_words > .recent > ul > li > span.del {position:absolute; top:3px; right:0; display:block; width:22px; height:30px; background:url(/app/images/ico_del.png) no-repeat right center; background-size:16px 16px; text-indent:-9999px;}
.my_words > .auto > ul {margin-top:-7px;}
.my_words > .auto > ul > li {}
.my_words > .auto > ul > li > a {display:block; padding:8px 0; font-weight:700; font-size:15px; color:#292929;}
.my_words > .auto > ul > li > a > span {color:#1c32f7;}


/* apt_list */
.apt_list_wrap {position:relative; height:100%; overflow:hidden;}
.sorting {padding:12px 16px 9px; background:#f5f5f5;}
.sorting > ul {padding-bottom:2px; overflow:hidden;}
.sorting > ul > li {float:left; position:relative;}
.sorting > ul > li:before {content:''; display:block; position:absolute; top:4px; left:0; width:1px; height:12px; background:#999;}
.sorting > ul > li > a {font-size:13px; padding:0 8px; color:#333;}
.sorting > ul > li > a:hover {color:#1c32f7;}
.sorting > ul > li:first-child:before {display:none;}
.sorting > ul > li:first-child > a {padding-left:0;}
.sorting > ul > li > a.on {color:#1c32f7;}
.sorting .checkbox .checkmark {top:5px;}

.apt_list_area {position:relative; height:calc(100% - 152px); -webkit-overflow-scrolling: touch;}
.apt_list {height:100%; padding-bottom:88px; overflow-y:auto;}
.apt_list > .item {padding:14px 0 14px 16px; border-bottom:1px solid #e3e3e3;}
.apt_list > .item.noData {height:96px; padding:0; line-height:96px; text-align:center;}
.apt_list > .item > .title {font-weight:700; font-size:15px;}
.apt_list > .item > .title > span {display:inline-block; margin-left:6px; padding:0 6px; font-size:13px; color:#666; border-radius:1px; background:#e5e5e5;}
.apt_list > .item > .title > span.sise {margin-left:4px; font-size:12px; color:red; line-height:17px; border:1px solid red; background:#fff;}
.apt_list > .item > .title > span.building {font-size:11px; color:#fff; border-radius:2px; vertical-align:2px;}
.apt_list > .item > .title > span.building.buildingA {background:#1c32f7 !important;}
.apt_list > .item > .title > span.building.buildingO {background:#1bb70e !important;}
.apt_list > .item > .title > span.building.buildingD {background:#a3a5a9 !important;}
.apt_list > .item > .info {padding-top:5px; white-space:nowrap; overflow:hidden;}
.apt_list > .item > .info > span {display:inline; position:relative; font-size:13px; padding:0 7px 0 8px; color:#333; letter-spacing:-0.04em;}
.apt_list > .item > .info > span:before {content:''; display:block; position:absolute; top:1px; left:0; width:1px; height:12px; background:#999;}
.apt_list > .item > .info > span:first-child {padding-left:0;}
.apt_list > .item > .info > span:first-child:before {display:none;}
.apt_list > .item > .info > span.on {color:#1c32f7;}
.apt_list > .item > .addr {padding-top:1px; font-size:12px;}


.apt_list > .item:hover {background:#f0f1ff;}
.apt_list > .item:hover > .title {text-decoration:underline;}
.apt_list_wrap .btn_wrap {position:fixed; right:16px; bottom:16px; left:16px;}


/* sale_of_map */
.sale_of_apt {height:100%; overflow:hidden;}

.sale_list_wrap {position:relative; height:100%; overflow:hidden; z-index:99999;}
.sale_list_head {position:relative; height:86px; padding:0 16px; background:#fff; overflow:hidden;}
.sale_list_head > div {position:relative; overflow:hidden;}
.sale_list_head > .type {height:46px;}
.sale_list_head > .type > ul {margin-top:7px; overflow:hidden;}
.sale_list_head > .type > ul > li {float:left;}
.sale_list_head > .type > ul > li > a {display:block; float:left; width:64px; height:32px; margin-right:8px; font-weight:700; line-height:32px; border-radius:16px; background:#f4f4f4; text-align:center;}
.sale_list_head > .type > ul > li > a.on {color:#fff; background:#1c32f7;}
.sale_list_head > .type > .close {position:absolute; top:11px; right:0; display:block; width:24px; height:24px; background:url(/app/images/ico_cancel.png) no-repeat center center; background-size:20px 20px; text-indent:-9999em;}
.sale_list_head > .align {height:40px;}
.sale_list_head > .align > p {position:absolute; top:2px; right:0; float:right; font-weight:700; font-size:12px; line-height:36px;}
.sale_list_head > .align > ul {float:left; overflow:hidden;}
.sale_list_head > .align > ul > li {float:left; position:relative;}
.sale_list_head > .align > ul > li:before {content:''; display:block; width:1px; height:12px; position:absolute; top:13px; left:0; background:#545454;}
.sale_list_head > .align > ul > li:first-child:before {display:none;}
.sale_list_head > .align > ul > li > a {display:block; height:36px; padding:0 7px; font-size:13px; line-height:36px;}
.sale_list_head > .align > ul > li:first-child > a {padding-left:0;}
.sale_list_head > .align > ul > li > a.on {color:#1c32f7;}


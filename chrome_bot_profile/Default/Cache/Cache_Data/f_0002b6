	const filter0 = document.querySelectorAll(".filter_bttn");
	filter0.forEach(filter => filter.addEventListener("click", t => toggleFilter(t.target, tab0)));
	function toggleFilter(el, filters) {
		page = 0;
		if (filters.length === 1 && filters.indexOf(el.value) >= 0) {
			return;
		}
		if (filters.indexOf(el.value) === -1) {
			filters.push(el.value);
			el.ariaPressed = true;
		} else {
			filters.splice(filters.indexOf(el.value), 1);
			el.ariaPressed = false;
		}

		const tempFilter = filters.filter(code => code === 'A01' || code === 'A02');

		if (tempFilter.length === 1 && tempFilter[0] === 'A01') {
			setAptOption(APT);
		} else if (tempFilter.length === 1 && tempFilter[0] === 'A02') {
			setAptOption(OFFICETEL);
		} else {
			setAptOption(ALL);
		}
		count = 0;
		search();
	}

	function initFilter() {
		$('#apt').val("");
		tab0.length = 0;
		filter0.forEach(filter => {
			tab0.push(filter.value);
			filter.ariaPressed = true
		});
	}

	function objectToQueryString(obj) {
		const str = [];
		for (let p in obj)
			if (obj.hasOwnProperty(p)) {
				str.push(encodeURIComponent(p) + "=" + encodeURIComponent(obj[p]));
			}
		return str.join("&");
	}


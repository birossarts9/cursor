	const dealTypeButtons = document.querySelectorAll(".mml_srch_area .type ul li");
	dealTypeButtons.forEach(btn => btn.addEventListener("click", function(e) {
		let element = e.target;
		while (element.nodeName !== "LI") {
			element = element.parentNode;
		}
		element.children[0].classList.toggle("on")
		const selectedCnt = Array.from(dealTypeButtons).reduce((previous, current) => {
			return current.children[0].classList.contains("on") ? previous + 1 : previous
		}, 0);
		if (selectedCnt === 0) {
			dealTypeButtons.forEach(btn => btn.children[0].classList.add("on"));
		}
		count = 0;
		page = 0;
		search();
	}));

	function throttle(func, wait) {
		let waiting = false;
		return function () {
			if (waiting) {
				return;
			}

			waiting = true;
			setTimeout(() => {
				func.apply(this, arguments);
				waiting = false;
			}, wait);
		};
	}

	const onScroll = throttle(() => {
		if (before < scrollElement.scrollTop) {
			if (scrollElement.scrollTop < 30) { return; }
			headerElement.classList.add("hide");
			adjustHeaderHeight();
			removeExpandedAddress();
			document.getElementById('kakao-profile').innerText= '';
			before = scrollElement.scrollTop;
		} else {
			if (before > scrollElement.scrollTop + 50 || scrollElement.scrollTop === 0) {
				headerElement.classList.remove("hide");
				adjustHeaderHeight();
				document.getElementById('kakao-profile').innerText= '카톡 프로필';
				before = scrollElement.scrollTop;
			}
		}
	}, 100);

	scrollElement.addEventListener("scroll", onScroll);

	// src의 콜백 함수 이름은 밑에서 정의할 함수 이름과 동일하게
	function search() {
		removeExpandedAddress();
		if (page === 0) { clear() };
		const xmlHttp = new XMLHttpRequest();
		xmlHttp.onreadystatechange = function () {
			if (this.status === 200 && this.readyState === 4) {
				if (page === 0) { clear() };
				const data = JSON.parse(this.responseText);
				hasNext = data.next_page;
				if (data.result) {
					setSale(data);
					if (firstOffer) {
						highlight(firstOffer);
						firstOffer = "";
					}
				} else {
					if (page === 0) {
						$('.sale_list_ver2').append('<div class="noData"> 검색 조건에 해당하는 매물이 없습니다.</div>');
					}
				}
			}
		};

		// const offerType = $("#offerType option:selected").val();
		const apt = $("#apt option:selected").val() ;

		let realEstateType = tab0.join(",");
		if (apt !== "") {
			// A01 A04 B01 A03 B03
			let allType = ["A01", "A04", "B01", "A03", "B03", ...tab0];
			const unique = allType.filter((element, index) => {
				return allType.indexOf(element) === index;
			})
			realEstateType = unique.join(",");
		}

		const dealType = Array.from(dealTypeButtons)
				.filter(btn => btn.children[0].classList.contains("on"))
				.map(btn => btn.dataset.value)
				.join(",");

		const params = {
			member: "44033", //36910
			oidx:oidx ,
			oby:oby ,
			total: 20,
			dealmode: dealType,
			rlsttype_cd: realEstateType, //offerType, // 아파트 코드로 보내도록 수정.
			hscp_no: apt, // 네이버 아파트 코드.
			last_mm_num: count * total,
			mm_uid: firstOffer === null || firstOffer === undefined ? "": firstOffer
		}
		xmlHttp.open('GET', 'https://realty.asil.kr/api_asil/data_sale_of_member.aspx?' + objectToQueryString(params));
		xmlHttp.send();
		++count;
	}


	function loadSubwayLine(el, city) {
		if(subwayLines[city].length === 0) {
			const http = new XMLHttpRequest();
			http.onreadystatechange = function () {
				if(this.readyState === 4 && this.status === 200) {
					var obj = JSON.parse(http.responseText);
					obj.forEach(function(item){
						subwayLines[city].push(item.line);
					});
					for(var i=0; i<subwayLines[city].length; i++) {
						el.append('<li><a onclick="getSubway(this.innerText, '+city+','+i+');return false;">'+subwayLines[city][i]+'</li>');
					}
				}
			};
			http.open('GET', '/json/subway_list_web.jsp?type=line&subway=' + city);
			http.send();
		} else {
			for(var i=0; i<subwayLines[city].length; i++) {
				el.append('<li><a onclick="getSubway(this.innerText, '+city+','+i+');return false;">'+subwayLines[city][i]+'</li>');
			}
		}
	}

	function loadSubwayStation(el, city, line) {
		if(subwayLines[city][line] === undefined) subwayLines[city][line] = [];
		if(subwayLines[city][line].length === 0) {
			const http = new XMLHttpRequest();
			http.onreadystatechange = function () {
				if(this.readyState === 4 && this.status === 200) {
					var obj = JSON.parse(http.responseText);
					obj.forEach(function(item){
						subwayLines[city][line].push([item.name, item.x, item.y]);
					});
					for(var i=0; i<subwayLines[city][line].length; i++) {
						el.append('<li><a href="javascript:clickStation('+subwayLines[city][line][i][1]+','+subwayLines[city][line][i][2]+');">'+subwayLines[city][line][i][0]+'</li>');
					}
				}
			};
			http.open('GET', encodeURI("/json/subway_list_web.jsp?type=&subway=" + city + "&line=" + line));
			http.send();
		} else {
			for(var i=0; i<subwayLines[city][line].length; i++) {
				el.append('<li><a href="javascript:clickStation('+subwayLines[city][line][i][1]+','+subwayLines[city][line][i][2]+');">'+subwayLines[city][line][i][0]+'</li>');
			}
		}
	}


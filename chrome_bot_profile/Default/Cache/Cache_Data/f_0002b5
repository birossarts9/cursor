	function clickTraffic(t_key, t_lat, t_lng, t_zoom){
		if(traffic_key == null) {
			traffic_key = '';

			tileGridLayer = new naver.maps.Layer('tileGrid', {
				name: "TileGrid",
				minZoom: -1,
				maxZoom: 17,
				tileSize: new naver.maps.Size(256, 256),
				getTile: function(x, y, z) {
					var div = $('<div class="tilegrid"></div>');
					return div[0];
				}
			});

		}

		if((new Date().getTime() - trafficTime) < 200) {
			return;
		}

		if(t_key != '' && traffic_key == '') {
			for(i in trafficTextArray) {				trafficTextArray[i][1].setMap((t_key == trafficTextArray[i][0] ? map : null));					}
			for(i in trafficPolylineArray) {			trafficPolylineArray[i][1].setMap((t_key == trafficPolylineArray[i][0] ? map : null));			}
			for(i in trafficStationArray) {			trafficStationArray[i][1].setMap((t_key == trafficStationArray[i][0] ? map : null));			}
			traffic_key = t_key;
			//map.addOverlayMapTypeId(naver.maps.MapTypeId.TILE_NUMBER);
			$('.stationTitle.up').addClass('up2'); //$('.up2').removeClass('up');
			$('.stationTitle.down').addClass('down2'); //$('.up2').removeClass('up');

			clearRedevelop();
			clearEducation();
			removeAllMap();

			var center = map.getCenter();
			trafficLat = center.lat();
			trafficLng = center.lng();
			trafficZoom = map.getZoom();

			moveMap(t_lat, t_lng, t_zoom);
			//map.setZoom(8);
			tileGridLayer.setMap(map);
		}else {
			tileGridLayer.setMap(null);
			traffic_key = '';
			trafficTime = new Date().getTime();
			moveMap(trafficLat, trafficLng, trafficZoom);
		}
	}


		subwayLine.innerHTML = '';
		subwaySi.innerHTML = cityName;
	}

	function getSubway(name, city, line) {
		var subwayLine = document.querySelector('.sbwy_head span:nth-child(2)');
		
		var lines = document.querySelectorAll('.sbwy_nmbr a');
		if(lines.length > 0) {
			[].forEach.call(lines, function (line) {

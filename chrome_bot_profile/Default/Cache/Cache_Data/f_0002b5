	var script2;
	function callJs(url){
		script2 = document.createElement('script');
		script2.type ='text/javascript';
		script2.charset ='euc-kr';
		script2.src = url;
		setTimeout("callJsProcess()", 200);
	}
	function callJsProcess(){
		document.getElementsByTagName('head')[0].appendChild(script2);
	}

	function callJs_Area(url){
		var script3 = document.createElement('script');
		script3.type ='text/javascript';
		script3.charset ='euc-kr';
		script3.src = url;
		document.getElementsByTagName('head')[0].appendChild(script3);
	}

	//============= 지도확대/축소 ===================//
	function zoomIn() {    if (map.getZoom() >= 18) return; map.setZoom(map.getZoom() + 1, false);	}
	function zoomOut() {   if(map.getZoom() < 9) return;  map.setZoom(map.getZoom() - 1, false);	}

	function getPolyline(linePath, color, lineStyle) {
		var polyline = new naver.maps.Polyline({
			map: map,
			path: linePath,
			strokeWeight: 3,
			strokeColor: color,
			strokeOpacity: 0.8,
			strokeStyle: lineStyle
		});
		return polyline;
	}

	function getPolygon(polygonPath, stroke, fill, opacity) {
		var polygon = new naver.maps.Polygon({
			map: map,
			paths: polygonPath,
			strokeWeight: 1,
			strokeColor: stroke,
			strokeOpacity: 1.0,
			strokeStyle: 'solid',
			fillColor: fill,
			fillOpacity: opacity
		});

		return polygon;
	}


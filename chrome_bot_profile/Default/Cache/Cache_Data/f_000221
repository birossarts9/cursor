/* reset */
body, div, p, span, a, dl, dt, dd, ul, ol, li, h1, h2, h3, h4, h5, h6, table, th, td, form, fieldset, legend, input, button, select, textarea {margin:0; padding:0; -webkit-box-sizing:border-box; -moz-box-sizing:border-box; box-sizing:border-box;}
body, input, button, select, textarea {font-family:'맑은 고딕', '나눔고딕', '돋움', Dotum, '굴림', Gulim, Sans-serif; font-weight:400; font-size:14px; color:#333; line-height:22px; letter-spacing:-0.06em;}
article, aside, footer, header, nav, section {display:block;}
fieldset, img {border:0;}
a {color:#333; text-decoration:none;}
li {list-style:none;}
hr {display:none;}
table {width:100%; border-collapse:collapse; border-spacing:0;}
legend, caption {width:0; height:0; font-size:0; line-height:0;}
input:focus, select:focus {outline:0;}
input, button, select, textarea {-webkit-appearance:none; -moz-appearance:none; appearance:none; border:0;}
::-ms-clear,::-ms-reveal,::-ms-expand {display:none;}
.hide {position:absolute; top:-9999px; width:0; height:0; font-size:0;}

::-webkit-scrollbar {
    width:8px;
    height:8px;
} 
::-webkit-scrollbar-track {
    background-color:rgba(0,0,0,0);
    border-radius:8px;
} 
::-webkit-scrollbar-thumb {
    background-color:rgba(173,173,173,0);
    border-radius:8px;
}
body:hover::-webkit-scrollbar-thumb,
div:hover::-webkit-scrollbar-thumb {
    background-color:rgba(173,173,173,0.5);
    border-radius:8px;
}


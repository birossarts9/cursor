.tbl_st4 td.line1,
.tbl_st4 td.line2,
.tbl_st4 td.line3 {position:relative;}
.tbl_st4 td.line1:after,
.tbl_st4 td.line2:after,
.tbl_st4 td.line3:after {content:''; position:absolute; top:0; right:0; bottom:0; display:block; width:5px;}
.tbl_st4 td.line1:after {background:#a4adfc;}
.tbl_st4 td.line2:after {background:#ffc1b5;}
.tbl_st4 td.line3:after {background:#a4e29f;}


/* reset */
::selection {background:#1c32f7; color:#fff;}
body, div, p, span, a, dl, dt, dd, ul, ol, li, h1, h2, h3, h4, h5, h6, table, th, td, form, fieldset, legend, button, input, select, textarea {margin:0; padding:0; box-sizing:border-box; -moz-box-sizing:border-box; -webkit-box-sizing:border-box;}
body, th, td, button, input, select, textarea {font-family:'SpoqaHanSansNeo','나눔고딕', '맑은 고딕', '돋움', Dotum, '굴림', Gulim, Sans-serif; font-weight:400; font-size:14px; color:#282828; line-height:1.5; letter-spacing:-0.02em; -webkit-text-size-adjust:none; -moz-text-size-adjust:none; -ms-text-size-adjust:none;}
article, aside, footer, header, nav, section {display:block;}
fieldset, img {border:0;}
a {color:#333; text-decoration:none;}
li {list-style:none;}
hr {display:none;}
table {width:100%; border-collapse:collapse; border-spacing:0;}
legend, caption {width:0; height:0; font-size:0; line-height:0;}
input:focus, select:focus {outline:0;}
input, button, select, textarea {-webkit-appearance:none; -moz-appearance:none; appearance:none; border:0;}
::-ms-clear,::-ms-reveal,::-ms-expand {display:none;}
.blind {position:absolute; top:-9999px; width:0; height:0; font-size:0; line-height:0; text-indent:-9999em;}
.hr {width:100%; height:12px; background:url(/app/images/hr.png) repeat-x; background-size:1px 12px;}
.dotLine {width:100%; height:27px; margin-top:9px; border-top:1px dashed #bfc4ce;}
iframe {border:0;}
input, textarea {font-family:'맑은 고딕' !important;}

*:not(select)::-webkit-scrollbar {width:8px; height:8px;} 
::-webkit-scrollbar-track {background-color:rgba(0,0,0,0); border-radius:8px;} 
::-webkit-scrollbar-thumb {background-color:rgba(173,173,173,0); border-radius:8px;}
.asilScroll {position:relative; width:100%; height:100%; overflow-y:auto;}
.asilScroll:hover::-webkit-scrollbar-thumb,
div:hover::-webkit-scrollbar-thumb {background-color:rgba(173,173,173,0.5); border-radius:8px;}
select::-webkit-scrollbar-thumb{background-color:rgba(173,173,173,0.5); border-radius:8px;}



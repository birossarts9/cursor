.tbl_st4 thead th > span.regdateArrow {color:#000;}
.tbl_st4 td {color:#080808;}
.tbl_st4 td.up {background:#edefff;}
.tbl_st4 td.up > span {font-size:12px; color:#1c32f7;}
.tbl_st4 td.down {background:#fff3f0;}
.tbl_st4 td.down > span {font-size:12px; color:#ff6544;}
.tbl_st4 tr.pick td {background:#e8eafe;}
.tbl_st4 td.tdL {padding-left:6px; text-align:left;}
.tbl_st4.tdL td {padding-left:6px; text-align:left;}
.tbl_st4 tr.best td {background:#ffebeb;}
.tbl_st4 tr td.best {background:#ffebeb;}
.tbl_st4 tr td.best_d {background:#edefff;}
.tbl_st4 tr td.best_u {background:#ffebeb;}
.tbl_st4 td .rate {font-size:10px; color:#e50000;}
.tbl_st4 td .rank {display:inline-block; width:15px; height:15px; margin-left:3px; padding-top:3px; font-size:10px; color:#fff; line-height:1; border-radius:50%; background:#e50000; text-align:center;}

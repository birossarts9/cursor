.mode_head > .tit > i:before {content:'?'; position:absolute; top:-3px; left:0; display:block; padding-left:4px; font-style:normal; font-size:11px; color:#777;}
.mode_head > .txt {margin-top:-2px; font-weight:bold; font-size:12px; color:#666; line-height:20px;}
.mode_head > .close {position:absolute; top:50%; right:8px; display:block; width:24px; height:24px; margin-top:-12px; background:url(/app/images/ico_cancel.png) no-repeat center center; background-size:20px 20px; text-indent:-9999em;}

.mode_cont {position:relative; padding:16px;}
.mode_desc {position:absolute; top:0; right:0; left:0; bottom:0; padding:10px 16px 16px; font-size:13px; background:#fff;}
.mode_desc > p {width:calc(100% - 24px); font-weight:bold; font-size:12px; line-height:18px;}
.mode_desc > a {position:absolute; top:8px; right:11px; display:block; width:24px; height:24px; background:url(/app/images/ico_cancel.png) no-repeat center center; background-size:18px 18px; text-indent:-9999em;}

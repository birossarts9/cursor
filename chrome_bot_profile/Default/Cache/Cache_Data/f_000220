.mode_wrap {display:none; position:absolute; top:0; left:83px; width:400px; border:2px solid #1c32f7; border-radius:6px; background:#fff; overflow:hidden;}
.mode_head {position:relative; /*height:39px;*/ padding:5px 10px 4px; border-bottom:1px solid #f5f5f5;}
.mode_head > .tit {font-weight:800; font-size:15px; color:#000; line-height:20px;}

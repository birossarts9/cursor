.mode_desc > div .word_desc_img {text-align:center;}
.mode_desc > div .word_desc_img > img {width:100%;}
.mode_list {margin:-5px 0 0 -5px; overflow:hidden;}
.mode_list > li {float:left; width:33.333%; padding:5px 0 0 5px; overflow:hidden;}
.mode_list > li:first-child {border-left:0;}
.mode_list > li a {display:block; height:42px; padding:0 8px 0 6px; line-height:42px; color:#888; background:#f5f5f5; border-radius:5px; text-align:center;}
.mode_list > li a.on {color:#1c32f7; background:rgba(28,50,247,0.12);}
.mode_list > li a.off {color:#ccc; background:#f8f8f8;}


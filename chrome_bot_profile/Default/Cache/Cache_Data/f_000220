.map_type > div {display:none; position:fixed; width:280px; height:100px; right:70px; margin-top:-52px; padding:6px; border:2px solid #1c32f7; border-radius:6px; background:#fff; overflow:hidden;}
.map_type > div > ul {overflow:hidden;}
.map_type > div > ul > li {float:left;}
.map_type > div > ul > li > a {display:block; position:relative;}
.map_type > div > .type1 {margin:0 -4px;}
.map_type > div > .type1 > li { width:33.333%; padding:0 4px;}
.map_type > div > .type1 > li > a {height:44px; line-height:44px; border-radius:1px; text-align:center;}
.map_type > div > .type1 > li > a.img1 {color:#000; background:url(/asil/images/img_map1.png) no-repeat center center; background-size:170px 170px;}
.map_type > div > .type1 > li > a.img2 {color:#fff; background:url(/asil/images/img_map2.png) no-repeat center center; background-size:170px 170px;}
.map_type > div > .type1 > li > a.img3 {color:#000; background:url(/asil/images/img_map3.png) no-repeat center center; background-size:170px 170px;}
.map_type > div > .type1 > li > a > span {position:relative; font-weight:700; font-size:13px;}
.map_type > div > .type1 > li > a.on:before {content:''; position:absolute; top:0; left:0; display:block; width:100%; height:44px; color:#fff; border:2px solid #1c32f7; background:rgba(28,50,247,0.5); box-sizing:border-box;}
.map_type > div > .type1 > li > a.on > span {color:#fff;}
.map_type > div > .type2 {margin-top:9px; padding:0 0 6px 1px;}
.map_type > div > .type2 > li {width:20%;}
.map_type > div > .type2 > li:nth-of-type(1), 
.map_type > div > .type2 > li:nth-of-type(2), 
.map_type > div > .type2 > li:nth-of-type(3) {width:20%;}
.map_type > div > .type2 > li:nth-of-type(4) {width:19%; padding-right:8px;}
.map_type > div > .type2 > li:nth-of-type(5) {width:21%;}
.map_type > div > .type2 > li > a {height:30px; padding-left:20px; line-height:30px; font-weight:700; font-size:12px; color:#000;}
.map_type > div > .type2 > li > a:before {content:''; position:absolute; top:6px; left:0; width:14px; height:14px; border:1px solid #cacfd9;}
.map_type > div > .type2 > li > a.on {color:#1c32f7;}
.map_type > div > .type2 > li > a.on:before {border-color:#1c32f7; background:#1c32f7 url(/app/images/frm_check2.png) no-repeat center center; background-size:14px 14px;}
.map_type > div > .type2 > li > span {display:block; height:20px; margin:4px 0 0 0; font-weight:700; font-size:12px; color:#000; line-height:18px; border:1px solid #666; border-radius:11px; text-align:center; cursor:pointer;}


.map_btn_zoom {border:1px solid #777; border-radius:3px; box-shadow:1px 1px 1px rgba(0,0,0,0.2); background:#fff; overflow:hidden;}
.map_btn_zoom a {display:block; width:36px; height:36px; text-indent:-9999px; cursor:pointer;}
.map_btn_zoom a:first-child {height:37px; border-bottom:1px solid #777;}
.map_btn_zoom a.zoomin {background:url(/asil/images/map/map_btn_zoom.png) no-repeat center 0;}
.map_btn_zoom a.zoomout {background:url(/asil/images/map/map_btn_zoom.png) no-repeat center -36px;}

.map_popup {display:none; position:absolute; z-index:1020; min-width:114px; margin-top:-52px;}
.map_btn_left .map_popup {left:52px;}
.map_btn_right .map_popup {right:60px; padding-left:18px;}
.map_popup > div {border:2px solid #1c32f7; border-radius:6px; background:#fff; overflow-y:hidden;}
.map_popup > div > a {display:block; height:28px; padding:0 10px; line-height:28px; font-weight:700; font-size:13px; border-top:1px solid #eee;}
.map_popup > div > a:first-child {border-top:0;}
.map_popup > div > a.on {color:#1c32f7;}
.map_popup > ul {padding:0 10px; border:1px solid #777; border-radius:3px; background:#fff; overflow-y:auto;}
.map_popup > ul li {position:relative; padding-right:18px; border-top:1px solid #ccc;}
.map_popup > ul li:first-child {border-top:0;}
.map_popup > ul li > a {display:block; width:98%; height:27px; line-height:27px; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.map_popup > ul li > a.on {color:#1c32f7;}
.map_popup > ul li span {position:absolute; top:0; right:0; display:block;}
.map_popup > ul li span > a {display:block; width:18px; height:27px; text-align:center;}
.map_popup .close {position:absolute; top:-18px; width:19px; height:19px; border:1px solid #777; border-radius:3px; background:#fff url(/asil/images/common/popup_close.png) no-repeat center center; text-indent:-9999px;}
.map_btn_left .map_popup .close {right:0;}
.map_btn_right .map_popup .close {left:0;}
.map_house .map_popup {padding-right:18px;}
.map_house .map_popup .close {top:0;}
.map_develop .map_popup {width:150px;}
.map_develop .map_popup > div {}
.map_school .map_popup {margin-top:-52px;}
.map_rank .map_popup {width:150px; margin-top:-130px;}
.map_rank .map_popup > div {}
.map_fav .map_popup {padding-left:0;}
.map_fav .map_popup > ul {width:150px;}


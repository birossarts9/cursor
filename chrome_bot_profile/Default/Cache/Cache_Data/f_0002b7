		.agent_info > .num {margin-top:10px; font-size: 12px !important;}
		.agent_info > .btn {display:flex; display:-webkit-flex; margin-top:15px;}
		.agent_info > .btn > a {display:block; width:32%; height:30px; margin-left:2%; font-weight:bold; font-size:14px; color:#1c32f7; line-height:28px; border:1px solid #1c32f7; text-align:center; cursor:pointer;}

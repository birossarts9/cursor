<body >

<div id="app" >
	<div class="roadviewMask" v-if="popup.show" v-clock >
		<div class="roadviewPopup">
			<h2 class="h2"># {{popup.title}}</h2>
			<a class="close" @click="closePopup"><span>닫기</span></a>
			<div class="roadview">
				<iframe :src="popup.url" frameborder="0"></iframe>
			</div>
		</div>
	</div>

	<div class="callCenter" v-if="isValidOffer" v-clock>
		<a :class="{full: !openSms}" @click="sendTelV()">전화상담</a>

		<span v-if="openSms"></span>
		<a v-if="openSms" @click="sendSmsV" >문자상담</a>
	</div>

	<div class="apt_info asilScroll"  style="padding-bottom:54px;"  v-clock>
		<div class="reg_date" style="left:11px;"><span><!-- 등록일 : 년월일 --></span></div>
		

		
		<div class="article mt0" >
			<dl v-if="info.SVC_DATE_STRT === undefined" style="height: 90px; width: 100%">
			</dl>
			<dl class="danji_name">
				<dt>
					<span class="cate" style="display:none;"></span>
					<span v-if="info.SVC_DATE_STRT !== undefined" class="date">{{ dateFormat(info.SVC_DATE_STRT) + '등록'}} </span>
					<span v-if="buildingType !== ''">{{ buildingType }}</span>
					<strong>{{ replaceBuilding(info.BLDNM) }} <span v-if="info.DONG_NM !== undefined && info.DONG_NM !== ''">{{info.DONG_NM}}동</span> <span v-if="!(convertFloor === '' || convertFloor === '-')">{{convertFloor}}층</span></strong>
				</dt>
				<dd>
					<p class="adr">{{ info.mm_adr }}</p>

				</dd>
			</dl>
			<ul class="danji_area" v-if="moneyLabel.label" v-clock="">
				<li>
					<span>가격</span>
					<strong>{{moneyLabel.label}} {{moneyLabel.money}}<br><span class="per" v-if="priceByPy !== ''">평당 {{priceByPy}}만</span></strong>
				</li>
				<li>
					<span class="label">{{ m2Label }}</span>
					<strong style="position: relative">
						<span v-if="info.spc1 !== '0'">{{ removeDecimalPoint(info.spc1) }}</span> <span class="slash" v-if="!(info.spc1 === '0' || info.spc2 === '0')">/</span> <span v-if="info.spc2 !== '0'">{{ removeDecimalPoint(info.spc2) }}</span>㎡<br>
						<span class="py" onclick="togglePy()">{{ pyValue }}</span>
						<span class="hide m2" onclick="togglePy()"></span>
					</strong>
				</li>
			</ul>

			<div class="danji_memo" @click="sendTelV">
				<p class="img" ><img v-if="info.user_id" :src="getPhoto(agent.photo)"></p>
				<dl>
					<dt>{{agent.company}}</dt>
					<dd v-if="info.FETR_DESC !== ''">{{info.FETR_DESC}}</dd>
					<dd v-else>{{ contactNumber }}</dd>
				</dl>
			</div>

			<div class="danji_cont">
				<div v-if="images.length > 1 || (info.vr_flag === 'O' && info.naver_status == 3)" class="photo">
					<ul>
						<li v-if="info.vr_flag === 'O' && info.naver_status == 3">
							<a :href="'https://fin.land.naver.com/articles/' + info.naver_uid +'/tour'" target="_blank" style="place-content: center; background-color: #00de5a!important; margin-bottom: 5px;">
								<img src="./images/vr-icon.png" style="width: 26px; height: 15px; fill: none; top: 6px!important;" alt=""/>
								<p style="color: #1e1e23; font-size: 11px; font-weight: bold; text-align: center; margin-top: 14px; letter-spacing: -1.9px;">매물투어</p>
							</a>
						</li>
						<li  v-if="images.length > 1" v-for="(image, index) in images" @click="clickPhoto(index)" :key="index" >
							<a :class="{on : selectedPhotoIndex === index}">
								<img :src="image.img_val.replace('http://realty.asil.kr', 'https://realty.asil.kr')">
								<span></span>
							</a>
						</li>
					</ul>
				</div>
				<div class="photo_expand" @click="openPhotoMode()" style="display:block;" :style="{ display: images.length>0 ? 'block':'none'  }">
					<span></span>
					<div>
						<img :src="selectedPhoto.replace('http://realty.asil.kr', 'https://realty.asil.kr')" />
						<div class="watermark">
							<p>아실</p>
							<p class="text-xs">{{agent.company}}</p>
						</div>
					</div>
				</div>
				<ul>
					<li v-if="false">
						<strong>면적</strong>
						<span>{{m2Value.replaceAll(".00", "")}}</span>
					</li>
					<li v-if="info.flr_1_val !== '0' && info.flr_2_val !== '0'">
						<strong>해당층/총층</strong>
						<span>{{convertFloor}}층/{{info.flr_2_val}}층</span>
					</li>

					<template v-if="isBunyang">
						<li v-if="info.DEAL_AMT !== '0'">
							<strong>가격</strong>
							<span>{{info.amttxt}}</span>
						</li>
						<div style="margin-left: 10px; gap: 10px">
							<div v-if="info.DEAL_AMT !== '0'" style="display: flex; justify-content: space-between">
								<div>
									<strong style="margin-right: 8px; font-weight:500">분양가</strong>
								</div>
								<div>
									<span>{{numberToKorean(info.DEAL_AMT)}}</span>
								</div>
							</div>
							<div v-if="info.premium_price2 !== '0'" style="display: flex; justify-content: space-between">
								<div>
									<strong style="margin-right: 8px; font-weight:500">프리미엄</strong>
								</div>
								<div>
									<span>{{numberToKorean(info.premium_price2)}}</span>
								</div>
							</div>
							<div v-if="info.optionPrice !== '0' && info.optionPrice !== ''" style="display: flex; justify-content: space-between">
								<div>
									<strong style="margin-right: 8px; font-weight:500">옵션가격</strong>
								</div>
								<div>
									<span>{{numberToKorean(info.optionPrice)}}</span>
								</div>
							</div>
						</div>
					</template>

					<li v-if="info.MVIN_PSBL_NM !== ''">

		.sale_list_ver2 > .item > .cont {padding-top:3px; font-size:14px; color:#777; letter-spacing:-0.03em;}
		.sale_list_ver2 > .item > .cont.photo {width:calc(100% - 47px); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
		.sale_list_ver2 > .item > .cont > span {font-weight:bold; color:#333;}
		.hide { display: none; }
		.m2:before {content:''; position:absolute; left:calc(50% - 27px); display:block; width:13px; height:13px; margin-top:5px; background:url(/asil/images/i_refresh.png) no-repeat 0 0; background-size:cover; opacity:0.8; }
		.m2:after {content:'평전환'; color: #080808; position:absolute; left:calc(50% - 6px); display:block; margin-top:3px;  background-size:cover; opacity:0.8; }

	function fetchSaleDetail(offer) {
		if (!offer) {
			alert('매물정보가 없습니다.');
			return;
		}
		const xmlHttp = new XMLHttpRequest();
		xmlHttp.onreadystatechange = function () {
			if (this.status === 200 && this.readyState === 4) {
				saleInfos = JSON.parse(this.responseText.trim().replace(//g, ''));

				const offerInfo =  saleInfos.mm_json[0];
				const { PRCS_CD }  = offerInfo;
				if (PRCS_CD !== '4' && PRCS_CD !== '20') {
					window.location.href = "sale_close.jsp";
				}

				app.setInfo(saleInfos.mm_json[0]);
				if (saleInfos.mm_json_list) {
					//app.setOffers(saleInfos.mm_json_list);
				}
				app.setAdministrationCostInfo(saleInfos.administrationCostInfo);
				app.setBuiltinOptions(saleInfos.builttin_option);

				const mmUid = saleInfos.mm_json[0].mm_uid;

				if (mmUid !== '21550768') {
					app.setImages(saleInfos.mm_img_list);
				}

				loadAgent(offerInfo.user_id);
				if (offerInfo.MAP_LOC_YN !== "N") {
					if (offerInfo.kiso_rname === '직거래') {
						loadDirectOffer();
					}
					
					
					setMap(37.5129328, 127.0814839);
					
					
				} else {
					document.querySelector(".naver_map").style.display= 'none';
				}
			}
		};
		xmlHttp.open('GET', "https://realty.asil.kr/api_asil/data_sale_of_detail.aspx?mm_uid=" + offer);
		xmlHttp.send();
	}


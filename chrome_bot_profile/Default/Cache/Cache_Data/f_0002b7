	let isPanoramaInit = false;
	let position = null;
	let map = null;
	
	function setMap(lat, lng) {
		if (lat === '' || lng === '') {
			document.querySelector(".naver_map").style.display = "none";
			return;
		}

		if (lat && lng) {
			position =  new naver.maps.LatLng(lat, lng)
			const mapOptions = { center: position, zoom: 16 };

			map = new naver.maps.Map('map', mapOptions);
			// map.setOptions("mapTypeControl", true)

			let marker = new naver.maps.Marker({ position: position, map: map,
				icon: { url: '/app/images/map_pin.png', size: new naver.maps.Size(19, 24), anchor: new naver.maps.Point(10, 12), scaledSize: new naver.maps.Size(19, 24) }
			});
			marker.setZIndex(100);
			let streetLayer = new naver.maps.StreetLayer();

			let streetBtn = $('#street');
			streetBtn.on("click", function(e) {
				e.preventDefault();

				if (streetLayer.getMap()) {
					app.setPanoramaMode(false);
					streetLayer.setMap(null);
				} else {
					streetLayer.setMap(map);
				}
			})

			// 거리뷰 레이어가 변경되면 발생하는 이벤트를 지도로부터 받아 버튼의 상태를 변경합니다.
			naver.maps.Event.addListener(map, 'streetLayer_changed', function(streetLayer) {
				if (streetLayer) {
					streetBtn.text('지도');
				} else {
					streetBtn.text('로드뷰');
					showMap();
				}
			});


			// 지도를 클릭했을 때 발생하는 이벤트를 받아 파노라마 위치를 갱신합니다. 이때 거리뷰 레이어가 있을 때만 갱신하도록 합니다.
			naver.maps.Event.addListener(map, 'click', function(e) {
				if (streetLayer.getMap()) {
					let latlng = e.coord;

					// 파노라마의 setPosition()은 해당 위치에서 가장 가까운 파노라마(검색 반경 300미터)를 자동으로 설정합니다.
					if (!isPanoramaInit) {
						initPanorama();
					}
					app.setPanoramaMode(true);
					setTimeout(function() {
						pano.setPosition(latlng);

					}, 300);

					$("#map").hide();
					$("#roadview").show();
				}
			});
		}
	}
	

	function showMap() {
		$("#map").show();
		$("#roadview").hide();
	}

	
	function initPanorama() {
		setTimeout(function() {
			pano = new naver.maps.Panorama("roadview", {
				position: position,
				size: new naver.maps.Size(window.innerWidth - 32, 320),
				pov: {
					pan: -135,
					tilt: 29,
					fov: 100
				},
				aroundControl: true,
				aroundControlOptions: {
					position: naver.maps.Position.LEFT_BOTTOM,
				}
			});
		}, 300);

		isPanoramaInit = true;
	}
	

	function closePano() {
		showMap();
	}


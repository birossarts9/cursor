		.danji_name > dd > .tag {padding-top:6px; margin-top:2px;}
		.danji_name > dd > .tag > span {display:inline-block; height:20px; margin:0 1px; padding:0 5px; font-weight:bold; font-size:12px; color:#fff; line-height:18px; border:1px solid rgba(0,0,0,0.2);}
		.danji_name > dd > .tag > span.wesn {background:#2f75b5;}
		.danji_name > dd > .tag > span.part {background:#548235;}
		.danji_name > dd > .tag > span.heat {background:#c65911;}
		.danji_area {border-top:0;}
		.danji_memo {display:flex; display:-webkit-flex; align-items:center; margin-top:10px; padding:20px 0; border-top:1px solid #eee; border-bottom:1px solid #eee;}

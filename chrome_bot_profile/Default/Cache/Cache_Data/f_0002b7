		.callCenter {position:fixed; right:0; bottom:0; left:0; z-index:999; display:flex; display:-webkit-flex;}
		.callCenter > a {display:block; width:50%; height:54px; font-weight:bold; font-size:18px; color:#fff; line-height:54px; text-align:center; background:#1c32f7;}
		.callCenter > a.full {width:100% }
		.callCenter > span {position:absolute; top:14px; bottom:14px; left:50%; display:block; width:1px; background:rgba(255,255,255,0.8);}

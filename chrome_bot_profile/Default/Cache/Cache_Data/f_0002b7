				const urlRegex = /(https?:\/\/[^\s]+)/g;

				const urls = desc.match(urlRegex);

				if (urls !== null) {
					const uniqueUrls = urls.filter((element, index) => {
						return urls.indexOf(element) === index;
					});
					if (uniqueUrls !== null) {

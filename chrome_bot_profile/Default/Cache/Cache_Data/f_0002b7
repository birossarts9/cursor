<script type="text/javascript" src="/app/js/vue.global.js?1"></script>
<script>

	const isPhone = false;
	const uid = '';
	const {createApp} = Vue;
	const app = createApp({
		data() {
			return {
				popup: {
					show: false,
					title: '',
					url: '',
				},
				openSms: true,
				isPhone: isPhone,
				uid: uid,
				isOffer: true,
				onLoading: false,
				normalMap : true,
				selectedIndex: -1,
				selectedPhotoIndex: 0,
				photoModeIndex: 0,
				isPhotoMode: false,
				agent:{},
				info: {},
				builtins:[],
				offers:[],
				images:[],
				aptCode: ['A01','A04','B01','F01'],
				officetelCode: ['A02','B02'],
				panoramaMode: false,
				isShow: false,
				administrationCostInfo: {
					chargeCodeType: '',
					chargeCodeType_nm: '',
					chargeCriteriaCode: '',
					chargeCriteriaCode_nm: '',
					chargeInputContent: '',
					etcFeeDetails: {
						detailCodeType: '',
						detailCodeType_nm: '',
						etcFeeAmount: '',
						includeCodeTypes: [],
						includeCodeTypes_nm: [],
					}
				}
			}
		},
		methods: {
			// 관리비 1000 -> 1,000 로 변환
			formatNumberWithCommas(amount) {
				return amount ? amount.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",") : '';
			},
			toggleLayerFee() {
				this.isShow = !this.isShow;
			},
			validNumber(amount) {
				if (amount === null || amount === undefined) {
					return false;
				}
				let amt = amount.replace(/,/gi, "");
				return amt > 0;
			},
			openPopup(title, url) {
				this.popup.show = true;
				this.popup.title = title;
				this.popup.url = url;
				addNoScroll();
			},
			closePopup() {
				this.popup.show = false;
				this.popup.title = '';
				this.popup.url = '';
				removeNoScroll();
			},
			closePanoMode() {
				this.panoramaMode = false;
				closePano();
			},
			setPanoramaMode(isPano) {
				this.panoramaMode = isPano;
			},
			agentHome() {
				openHomepage(this.agent.cel)
			},
			clickPhoto(index){
				this.selectedPhotoIndex = index;
			},
			sendTelV() {
				
				if (this.isPhone || this.uid !== '') {
					location.href = 'tel:' + this.agent.cel;
				} else {
					sendTel(this.agent.cel);
				}
			},
			sendSmsV() {
				const message = "[아실] 잠실엘스 "
						+ this.info.spc1 + "㎡(" + Math.round(this.info.spc1_1) + '평' + ") \n"
						+ this.convertFloor + "층 " + this.moneyLabel.label +  " " + this.moneyLabel.money
						+  " 매물 문의드립니다.\n(매물번호 38520968)";

				
				if (this.isPhone || this.uid !== '') {
					location.href = 'sms:' + this.agentTel + '?' + 'body=' + message;
				} else {
					sendSms(this.agentTel, message);
				}
			},
			removeDecimalPoint(n) {
				return Math.floor(parseFloat(n) || 0);
			},
			replaceLastZero(n) {
				if (n === null || n === undefined || n === "NaN" || n === "") {
					return n;
				}
				try {
					const num = parseFloat(parseFloat(n).toFixed(15).replace(/0+$/, ""))
					return num;
				} catch (e) {
					return ""
				}
			},
			money(index) {
				const { DEALTYPE_CD, DEAL_AMT, WRRNT_AMT, LEASE_AMT } = this.offers[index];
				if (DEALTYPE_CD === 'A01') {
					return this.numberToKorean(DEAL_AMT);
				} else 	if (DEALTYPE_CD === 'B01') {
					return this.numberToKorean(WRRNT_AMT);
				} else {
					return this.numberToKorean(WRRNT_AMT) + "/" + this.numberToKorean(LEASE_AMT);
				}
			},
			dateFormat(register){
				if (register === null || register === undefined || register === '') {
					return register;
				}
				return register.substring(0, 4) + "." + register.substring(4, 6) + "." + register.substring(6);
			},
			generateLoanMessage(code, number) {
				const message1 = code === "0" ? "없음" : code === "1" ? "30% 미만" : code === "2" ? "30% 이상" : "";
				return message1 !== '' ? message1 : this.numberToKorean(number);
			},
			numberToKorean(number) {
				if (number === null || number === undefined) {
					return '';
				}
				let prefix = "";
				if (number.startsWith("-")) {
					prefix = "-";
					number = number.replace("-", "");
				}

				number = number.replace(/,/gi, "");
				number = number * 10000;
				let inputNumber = number < 0 ? false : number;
				let unitWords = ['', '만', '억', '조', '경'];
				let splitUnit = 10000;
				let splitCount = unitWords.length;
				let resultArray = [];
				let resultString = '';
				for (let i = 0; i < splitCount; i++) {
					let unitResult = (inputNumber % Math.pow(splitUnit, i + 1)) / Math.pow(splitUnit, i);
					unitResult = Math.floor(unitResult);
					if (unitResult > 0) {
						resultArray[i] = unitResult;
					}
				}


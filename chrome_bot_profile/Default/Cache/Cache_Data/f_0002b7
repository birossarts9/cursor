						: spc2 === '0' ? spctit1.replace("면적", "") + ': ' + Math.round(spc1_1) + '평' : spctit1.replace("면적", "") + '/' + spctit2.replace("면적", "") + ': ' + Math.round(spc1_1) + '/' + Math.round(spc2_1) + '평';

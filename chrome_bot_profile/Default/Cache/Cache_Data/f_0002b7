		.kakao_btn {position: relative; margin-top: 8px; background: #fff;}
		.sale_kkt > .kkt_frm { position: absolute; left: 0; width: calc(100% - 0px); z-index: 999; margin-top: 0px; padding: 20px; border-radius: 12px; background: #fff; box-shadow: 0 2px 8px 2px rgb(0 0 0 / 20%); }
		.sale_list_ver2 {background:#fafafa;}
		.sale_list_ver2 > .item {padding-left:13px;}
		.sale_list_ver2 > .item > .tit > span {margin-right:2px; padding:1px 3px 0; font-size:12px; color:#888; border:1px solid #888; vertical-align:middle;}
		.sale_list_ver2 > .item > .info {font-weight:800; font-size:13px; color:#555;}
		.sale_list_ver2 > .item > .info > strong {padding-right:5px; font-size:16px; font-weight:800; vertical-align:-1px;}
		.sale_list_ver2 > .item > .info > strong > span {padding-right:5px; font-size:13px; vertical-align:middle;}

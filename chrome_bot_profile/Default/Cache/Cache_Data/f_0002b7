		.roadview > iframe {width:100%; height:100%;}

		.btn_closePhoto {position:fixed; top:10px; right:10px; width:24px; height:24px; background:url(/app/images/ico_del_w.png) no-repeat center center; background-size:cover;}
		.btn_closePhoto > span {display:inline-block; text-indent:-9999em;}
		.btn_nextPhoto,.btn_prevPhoto {position: fixed; top:50%; width:30px; height:45px; margin-top:-23px; background-image:url(/app/images/arr.png); background-repeat:no-repeat;  background-size:60px 45px;}
		.btn_nextPhoto {right:8px; background-position:right center;}
		.btn_prevPhoto {left:8px; background-position:0 center;}
		.btn_nextPhoto > span,
		.btn_prevPhoto > span {display:inline-block; text-indent:-9999em;}
